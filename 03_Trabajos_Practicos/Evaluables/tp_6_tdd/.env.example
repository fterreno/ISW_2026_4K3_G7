# Credenciales para enviar el mail
MAIL_ECOHARMONY=
MAIL_CONTRASENA_ECOHARMONY=

# Ejemplo de como llenar las credenciales que se utilizan para enviar el mail. Son necesarias para AdaptadorMailGmail en entities/mail.py
# MAIL_ECOHARMONY=parckecoharmonyadministracion@gmail.com
# MAIL_CONTRASENA_ECOHARMONY=talb ksqq fpvy kbsf

# Credenciales de Mercado Pago (Access Token de la aplicación en https://www.mercadopago.com.ar/developers/panel/app)
# Para pruebas usar el Access Token de la cuenta vendedora de prueba
MP_ACCESS_TOKEN=

# Mail del comprador de prueba (opcional). Si está cargado, el checkout ya viene con ese mail y no lo pide;
# así Mercado Pago no confunde el pago con una cuenta real ("una de las partes es de prueba")
MP_EMAIL_COMPRADOR_PRUEBA=
